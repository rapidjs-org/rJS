{
  "private": true,
  "author": "Thassilo Martin Schiepanski",
  "workspaces": [ "./packages/*" ],
  "scripts": {
    "prepare": "npx husky",
    "clean:buildinfo": "find ./packages -name 'tsconfig.debug.tsbuildinfo' -delete",
    "clean:logs": "rm -rf ./test-app/.logs",
    "clean": "npm run clean:buildinfo && npm run clean:logs",
    "build": "node ./scripts/exec-deps.js build",
    "test": "node ./scripts/exec-deps.js test",
    "lint": "npm run -ws --if-present lint",
    "format": "npm run -ws --if-present format",
    "prerelease": "npm run clean && npm run build && npm test",
    "release": "npx rjs-releasing . --github"
  },
  "devDependencies": {
    "@rapidjs.org/releasing": "0.x",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.2",
    "loadtest": "^8.0.9"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rapidjs-org/rjs.git"
  }
}
