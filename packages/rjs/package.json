{
  "name": "@rapidjs.org/rjs",
  "version": "0.1.0",
  "author": "Thassilo Martin Schiepanski",
  "type": "commonjs",
  "main": "./build/mod.js",
  "types": "./types/mod.d.ts",
  "files": [
    "./build",
    "./types"
  ],
  "scripts": {
    "clean": "rm -rf ./build && rm -rf ./types",
    "build": "npm run clean && npx tsc --project ./tsconfig.build.json",
    "build:watch": "npx tsc --watch --project ./tsconfig.watch.json",
    "run:node": "node ./build/mod.js",
    "run:deno": "deno ./build/mod.js",
    "test": "deno test --allow-read ./test",
    "lint": "deno lint",
    "format": "deno fmt"
  },
  "devDependencies": {
    "@types/node": "^20.10.6",
    "typescript": "^5.3.3"
  }
}
